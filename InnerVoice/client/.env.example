# InnerVoice Frontend Environment Configuration
VITE_API_URL=https://api.innervoice4u.in

# Google Identity Services Client ID
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In Client ID & Redirect URI
# https://developer.apple.com/account/resources/identifiers/list/serviceId
VITE_APPLE_CLIENT_ID=com.innervoice.app.web
VITE_APPLE_REDIRECT_URI=http://localhost:5173/login
