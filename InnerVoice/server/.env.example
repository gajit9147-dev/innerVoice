# Server Environment Variables
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=innervoice
DB_PORT=3306

# Google Identity Services OAuth
# From Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Sign in with Apple OAuth
# From Apple Developer Portal: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=com.innervoice.app.web
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_KEY\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost:5173/login

# Cloudinary CDN (Image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email Service
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
